# Copia este archivo como .env para desarrollo local (npm run dev).
# En Vercel estas variables se cargan en Settings → Environment Variables.
# Guía completa: CONFIGURACION-POR-USUARIO.md

# ---------- IA ----------
# Proveedor: "gemini" (por defecto) o "experiential" (Claude/GPT/... vía Experiential Labs).
# AI_PROVIDER="gemini"

# Gemini. Obligatoria con AI_PROVIDER=gemini y recomendable siempre (respaldo automático).
# https://aistudio.google.com/apikey
GEMINI_API_KEY="tu_api_key_de_gemini"
# Opcional. Si no se define: gemini-3.8-flash.
# GEMINI_MODEL="gemini-3.8-flash"

# Experiential Labs (solo con AI_PROVIDER=experiential). Nombres de modelo exactos:
# https://platform.experientiallabs.ai/models
# EXPERIENTIAL_API_KEY="xpl_..."
# EXPERIENTIAL_MODEL="claude-opus-5.5"        # chat con Miguel
# EXPERIENTIAL_FAST_MODEL="claude-sonnet-5"   # planes y análisis (JSON)
# AI_FALLBACK="off"                           # desactiva el reintento con Gemini si Experiential falla

# ---------- Suunto ----------
# Opcional. Servidor MCP de Suunto usado para conectar la cuenta Suunto.
# Si no se define: https://mcp-ten-kappa.vercel.app
# SUUNTO_MCP_URL="https://mcp-ten-kappa.vercel.app"
